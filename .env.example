# Auth0 tenant domain, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=

# Auth0 Regular Web Application client credentials
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Minimum 32-character random string used to encrypt session cookies
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SESSION_ENCRYPTION_KEY=

# Base URL of this app (must match the Allowed Callback URL in Auth0 dashboard)
BASE_URL=http://localhost:3000
